<Window x:Class="HandheldTaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handheld Task Manager"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        ManipulationBoundaryFeedback="Window_ManipulationBoundaryFeedback">

    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Placeholder" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Text="{Binding Primary}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Secondary}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center"
                           TextAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center"
                           TextAlignment="Right" Margin="0,0,10,0"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Row_LeftUp"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Row_RightUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DriveTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,5,0,3"/>
                <TextBlock Text="{Binding Sub}" Style="{StaticResource CardSub}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============================ main layout ============================ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar: tabs, live summary, search, menu -->
            <Grid x:Name="TopBar" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabApps" Style="{StaticResource TabButton}" Content="Apps" Click="TabApps_Click"/>
                    <Button x:Name="TabProcesses" Style="{StaticResource TabButton}" Content="Processes" Click="TabProcesses_Click"/>
                    <Button x:Name="TabPerformance" Style="{StaticResource TabButton}" Content="Performance" Click="TabPerformance_Click"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,0"
                        Margin="6,0" Height="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="13">
                        <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="ChipCpu" Text="--" FontWeight="SemiBold" Margin="6,0,14,0" MinWidth="34"/>
                        <TextBlock Text="RAM" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="ChipRam" Text="--" FontWeight="SemiBold" Margin="6,0,0,0" MinWidth="34"/>
                        <StackPanel x:Name="ChipBatteryPanel" Orientation="Horizontal" Margin="14,0,0,0"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="ChipBatteryIcon" Text="&#xE83F;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChipBattery" Text="--" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE721;"
                        ToolTip="Filter by name" Click="Search_Click"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu"
                        Click="Menu_Click"/>
            </Grid>

            <!-- Apps / Processes -->
            <Grid x:Name="ListPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="12,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HeaderName" Style="{StaticResource HeaderButton}" Content="Name"
                            HorizontalAlignment="Left" Click="HeaderName_Click"/>
                    <Button x:Name="HeaderCpu" Grid.Column="1" Style="{StaticResource HeaderButton}" Content="CPU"
                            HorizontalContentAlignment="Right" Click="HeaderCpu_Click"/>
                    <Button x:Name="HeaderMemory" Grid.Column="2" Style="{StaticResource HeaderButton}"
                            Content="Memory" HorizontalContentAlignment="Right" Click="HeaderMemory_Click"/>
                </Grid>
                <ListBox x:Name="ProcList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" SelectionMode="Single"
                         ItemContainerStyle="{StaticResource RowStyle}"
                         ItemTemplate="{StaticResource RowTemplate}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         IsTextSearchEnabled="False">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="6,0,2,0" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Nothing to show" FontSize="16"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <!-- Performance -->
            <ScrollViewer x:Name="PerfPanel" Grid.Row="1" Visibility="Collapsed" Focusable="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Padding="6,0">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="CPU"/>
                                <TextBlock x:Name="CpuValue" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock x:Name="CpuSub" Style="{StaticResource CardSub}" Text=" "/>
                                <Grid x:Name="CpuChart" Height="64" Margin="0,10,0,0" ClipToBounds="True">
                                    <Polyline x:Name="CpuLine" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="MEMORY"/>
                                <TextBlock x:Name="MemValue" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock x:Name="MemSub" Style="{StaticResource CardSub}" Text=" "/>
                                <Grid x:Name="MemChart" Height="64" Margin="0,10,0,0" ClipToBounds="True">
                                    <Polyline x:Name="MemLine" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="BATTERY"/>
                                <TextBlock x:Name="BatValue" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock x:Name="BatSub" Style="{StaticResource CardSub}" Text=" "/>
                                <ProgressBar x:Name="BatBar" Maximum="100" Height="8" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="NETWORK"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="NetDown" Text="--" FontSize="20" FontWeight="SemiBold"
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="NetUp" Text="--" FontSize="20" FontWeight="SemiBold"
                                               Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardSub}" Text="Download and upload, all adapters"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="STORAGE"/>
                                <ItemsControl x:Name="DriveItems" ItemTemplate="{StaticResource DriveTemplate}"
                                              Focusable="False"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="SYSTEM"/>
                                <TextBlock x:Name="SysInfo" Margin="0,8,0,0" LineHeight="24" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar + controller hints -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="0,1,0,0" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" TextElement.FontSize="12">
                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Actions" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Text="X" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="End task" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Text="Y" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Sort" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource PadBadge}" Padding="6,0">
                            <TextBlock Text="LB RB" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tabs" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource PadBadge}">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Menu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ overlay (menus, dialogs, keyboard) ============================ -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed" Background="{DynamicResource OverlayDim}"
              MouseLeftButtonDown="Overlay_BackgroundDown"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border x:Name="OverlayCard" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <ContentControl x:Name="OverlayContent" Focusable="False"/>
            </Border>
        </Grid>

        <!-- ============================ toast ============================ -->
        <Border x:Name="Toast" Visibility="Collapsed" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,64" MaxWidth="640"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
