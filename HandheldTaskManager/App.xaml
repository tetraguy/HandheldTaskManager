<Application x:Class="HandheldTaskManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped at runtime by ThemeManager -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Replaced at runtime with the Windows accent colour -->
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#403B82F6"/>
            <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
